# Copiá este archivo a ".env" y completalo. NUNCA subas el .env a git.
PORT=3000
# Texto largo y aleatorio (mínimo 32 caracteres). Firma los JWT.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-32-o-mas-caracteres
JWT_HORAS=8
# Zona horaria de la clínica (el servidor de Azure corre en UTC)
APP_TZ=America/Argentina/Buenos_Aires

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mediturnosapp
# En Azure Database for MySQL dejalo en true. Para MySQL local, false.
DB_SSL=false
# Si Azure pide un certificado propio: ruta al .pem
# DB_SSL_CA=./certs/ca.pem

# Correo de confirmación y recuperación (SendGrid, remitente verificado).
# SENDGRID_API_KEY=
# CORREO_REMITENTE=MediTurnos <turnos@tu-dominio.example>

# FCM HTTP v1. Pegá el JSON completo de la cuenta de servicio como variable secreta.
# FCM_SERVICE_ACCOUNT_JSON=
